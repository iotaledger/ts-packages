{
    "name": "@iota/grpc",
    "version": "0.0.0",
    "description": "gRPC client for the IOTA network",
    "license": "Apache-2.0",
    "author": "IOTA Foundation <info@iota.org>",
    "sideEffects": false,
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "files": [
        "CHANGELOG.md",
        "dist",
        "src"
    ],
    "scripts": {
        "clean": "rm -rf tsconfig.tsbuildinfo ./dist",
        "dev": "pnpm build --watch",
        "build": "build-package",
        "codegen": "buf generate",
        "test": "vitest run unit --typecheck --typecheck.tsconfig ./test/tsconfig.json",
        "test:e2e": "vitest run e2e --typecheck --typecheck.tsconfig ./test/tsconfig.json"
    },
    "repository": "https://github.com/iotaledger/ts-packages",
    "bugs": {
        "url": "https://github.com/iotaledger/ts-packages/issues"
    },
    "homepage": "https://github.com/iotaledger/ts-packages#readme",
    "devDependencies": {
        "@bufbuild/buf": "^1.73.0",
        "@bufbuild/protoc-gen-es": "^2.15.0",
        "@iota/build-scripts": "workspace:*",
        "@noble/hashes": "^1.8.0",
        "typescript": "^5.5.3",
        "vitest": "^4.1.0"
    },
    "dependencies": {
        "@bufbuild/protobuf": "^2.15.0",
        "@connectrpc/connect": "^2.2.0",
        "@connectrpc/connect-node": "^2.2.0",
        "@iota/bcs": "workspace:*",
        "@iota/iota-sdk": "workspace:*"
    }
}
