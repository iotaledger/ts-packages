{
    "name": "@iota/grpc",
    "version": "0.0.0",
    "description": "gRPC client for the IOTA network",
    "license": "Apache-2.0",
    "author": "IOTA Foundation <info@iota.org>",
    "sideEffects": false,
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "files": [
        "CHANGELOG.md",
        "dist",
        "src"
    ],
    "scripts": {
        "clean": "rm -rf tsconfig.tsbuildinfo ./dist",
        "dev": "pnpm build --watch",
        "build": "build-package",
        "codegen": "buf generate",
        "test": "vitest run unit --typecheck --typecheck.tsconfig ./test/tsconfig.json",
        "test:e2e": "vitest run e2e --typecheck --typecheck.tsconfig ./test/tsconfig.json",
        "prepare:e2e:localnet": "iota-localnet start --with-faucet --force-regenesis --disable-fullnode-pruning --node-config-override fullnode:enable-grpc-api=true --node-config-override \"fullnode:grpc-api-config={address: '0.0.0.0:50051'}\"",
        "test:e2e:localnet": "wait-on http://127.0.0.1:9123 tcp:127.0.0.1:50051 -l --timeout 180000 && vitest run localnet --testTimeout 60000 --hookTimeout 180000 --typecheck --typecheck.tsconfig ./test/tsconfig.json",
        "size": "size-limit"
    },
    "repository": "https://github.com/iotaledger/ts-packages",
    "bugs": {
        "url": "https://github.com/iotaledger/ts-packages/issues"
    },
    "homepage": "https://github.com/iotaledger/ts-packages#readme",
    "devDependencies": {
        "@bufbuild/buf": "^1.73.0",
        "@bufbuild/protoc-gen-es": "^2.15.0",
        "@iota/build-scripts": "workspace:*",
        "@noble/hashes": "^1.4.0",
        "@size-limit/preset-small-lib": "^11.1.4",
        "size-limit": "^11.1.4",
        "typescript": "^7.0.2",
        "vitest": "^4.1.0",
        "wait-on": "^8.0.1"
    },
    "dependencies": {
        "@bufbuild/protobuf": "^2.15.0",
        "@connectrpc/connect": "^2.2.0",
        "@connectrpc/connect-node": "^2.2.0",
        "@iota/bcs": "workspace:*",
        "@iota/iota-sdk": "workspace:*"
    },
    "size-limit": [
        {
            "path": "dist/esm/index.js",
            "limit": "55 kB",
            "ignore": [
                "@connectrpc/connect-node"
            ]
        },
        {
            "path": "dist/cjs/index.js",
            "limit": "170 kB",
            "ignore": [
                "@connectrpc/connect-node"
            ]
        }
    ]
}
