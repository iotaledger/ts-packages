{
    "name": "@iota/grpc",
    "version": "0.0.0",
    "description": "gRPC client for the IOTA network",
    "license": "Apache-2.0",
    "author": "IOTA Foundation <info@iota.org>",
    "sideEffects": false,
    "type": "commonjs",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "files": [
        "CHANGELOG.md",
        "dist",
        "src"
    ],
    "scripts": {
        "clean": "rm -rf tsconfig.tsbuildinfo ./dist",
        "dev": "pnpm build --watch",
        "build": "build-package",
        "codegen": "buf generate",
        "test": "vitest run unit",
        "test:e2e": "vitest run e2e",
        "prettier:check": "prettier -c --ignore-unknown --ignore-path=../../.prettierignore --ignore-path=.prettierignore .",
        "prettier:fix": "prettier -w --ignore-unknown --ignore-path=../../.prettierignore --ignore-path=.prettierignore .",
        "eslint:check": "eslint --max-warnings=0 .",
        "eslint:fix": "pnpm run eslint:check --fix",
        "lint": "pnpm run eslint:check && pnpm run prettier:check",
        "lint:fix": "pnpm run eslint:fix && pnpm run prettier:fix"
    },
    "repository": "https://github.com/iotaledger/ts-packages",
    "bugs": {
        "url": "https://github.com/iotaledger/ts-packages/issues"
    },
    "homepage": "https://github.com/iotaledger/ts-packages#readme",
    "devDependencies": {
        "@bufbuild/buf": "^1.73.0",
        "@bufbuild/protoc-gen-es": "^2.15.0",
        "@iota/build-scripts": "workspace:*",
        "typescript": "^5.5.3",
        "vitest": "^4.1.0"
    },
    "dependencies": {
        "@bufbuild/protobuf": "^2.15.0",
        "@connectrpc/connect": "^2.2.0",
        "@connectrpc/connect-node": "^2.2.0"
    }
}
