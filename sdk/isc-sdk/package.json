{
    "name": "@iota/isc-sdk",
    "author": "IOTA Foundation <info@iota.org>",
    "version": "0.2.9",
    "description": "ISC SDK for interacting with IOTA Smart Contracts.",
    "repository": "https://github.com/iotaledger/ts-packages",
    "type": "commonjs",
    "license": "Apache-2.0",
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "scripts": {
        "clean": "rm -rf tsconfig.tsbuildinfo ./dist",
        "build": "build-package",
        "run:example": "tsx",
        "test": "vitest"
    },
    "dependencies": {
        "@iota/bcs": "workspace:*",
        "@iota/dapp-kit": "workspace:*",
        "@iota/iota-sdk": "workspace:*",
        "@noble/hashes": "^1.4.0"
    },
    "devDependencies": {
        "@iota/build-scripts": "workspace:*",
        "@types/node": "^24.0.0",
        "dotenv": "^16.4.5",
        "ethers": "^6.13.5",
        "tsx": "^4.8.1",
        "typescript": "^5.5.3",
        "vitest": "^4.1.0",
        "zod": "^3.25.76"
    }
}
