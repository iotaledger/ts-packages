{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "all",
    "useTabs": false,
    "sortPackageJson": false,
    "ignorePatterns": [
        "**/*.md",
        "**/*.mdx",
        "**/*.yml",
        "**/*.yaml",
        "/apps/icons/src",
        "npm-debug.log*",
        "package-lock.json",
        "yarn-debug.log*",
        "yarn-error.log*",
        ".next/",
        ".swc/",
        "build/",
        "coverage/",
        "dist/",
        "out/",
        "generated/",
        "playwright-report/",
        "storybook-static/",
        "**/*.toml",
        "test-results/",
        "wallet-dist-L1/",
        "wallet-dist-L2/",
        "apps/evm-bridge/scripts/",
        "sdk/signers/*.json"
    ],
    "overrides": [
        {
            "files": [
                "apps/explorer/**"
            ],
            "options": {
                "sortTailwindcss": {
                    "config": "apps/explorer/tailwind.config.ts"
                }
            }
        },
        {
            "files": [
                "apps/wallet/**"
            ],
            "options": {
                "sortTailwindcss": {
                    "config": "apps/wallet/tailwind.config.ts"
                }
            }
        },
        {
            "files": [
                "apps/wallet-dashboard/**"
            ],
            "options": {
                "sortTailwindcss": {
                    "config": "apps/wallet-dashboard/tailwind.config.ts"
                }
            }
        },
        {
            "files": [
                "apps/ui-kit/**"
            ],
            "options": {
                "sortTailwindcss": {
                    "config": "apps/ui-kit/tailwind.config.ts"
                }
            }
        }
    ]
}
