{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "all",
    "useTabs": false,
    "sortPackageJson": false,
    "ignorePatterns": [
        "/*",
        "!/apps",
        "!/sdk",
        "!/dapps",
        "!/.config",
        "!/*.js",
        "**/*.md",
        "**/*.mdx",
        "**/*.yml",
        "**/*.yaml",
        "/apps/icons/src",
        "npm-debug.log*",
        "package-lock.json",
        "yarn-debug.log*",
        "yarn-error.log*",
        ".next/",
        ".swc/",
        "build/",
        "coverage/",
        "dist/",
        "out/",
        "generated/",
        "playwright-report/",
        "storybook-static/",
        "/apps/evm-bridge/test-results",
        "/apps/evm-bridge/playwright-report",
        "/apps/evm-bridge/wallet-dist-L1",
        "/apps/evm-bridge/wallet-dist-L2",
        "/apps/evm-bridge/scripts",
        "/apps/explorer/test-results",
        "/sdk/signers/*.json",
        "**/*.toml",
        "**/*.rs"
    ],
    "overrides": [
        {
            "files": [
                "apps/explorer/**"
            ],
            "options": {
                "sortTailwindcss": {
                    "config": "apps/explorer/tailwind.config.ts"
                }
            }
        },
        {
            "files": [
                "apps/wallet/**"
            ],
            "options": {
                "sortTailwindcss": {
                    "config": "apps/wallet/tailwind.config.ts"
                }
            }
        },
        {
            "files": [
                "apps/wallet-dashboard/**"
            ],
            "options": {
                "sortTailwindcss": {
                    "config": "apps/wallet-dashboard/tailwind.config.ts"
                }
            }
        },
        {
            "files": [
                "apps/ui-kit/**"
            ],
            "options": {
                "sortTailwindcss": {
                    "config": "apps/ui-kit/tailwind.config.ts"
                }
            }
        }
    ]
}
